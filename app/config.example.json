{
  "// 1": "=== 模型 ===",
  "apiKey": "",
  "baseUrl": "https://api.deepseek.com/v1",
  "model": "deepseek-chat",
  "engine": "pi",
  "socialMemory": true,
  "web": {
    "enabled": true,
    "provider": "tavily",
    "apiKeyEnv": "TAVILY_API_KEY"
  },
  "pi": {
    "contextWindow": 131072,
    "maxTokens": 4096,
    "thinkingLevel": "high",
    "thinkingFormat": "deepseek"
  },
  "// 2": "=== 角色 ===",
  "roleCard": "role.md",
  "privateRoleCard": "role.private.md",
  "roleMaxChars": 12000,
  "// 3": "=== 她是谁 ===",
  "names": [
    "小鲸鱼"
  ],
  "keywords": [
    "小鲸鱼"
  ],
  "ownerIds": [
    "YOUR_QQ_ID"
  ],
  "// 4": "=== OneBot（NapCat / Lagrange / SnowLuma 都行）===",
  "onebot": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": ""
  },
  "// 5": "=== 什么时候说话 ===",
  "wake": {
    "groupAtOnly": true,
    "probability": 0.05,
    "privateWindowMs": 1500,
    "groupWindowMs": 6000,
    "groupExtensionMs": 1000,
    "groupMaxWindowMs": 10000
  },
  "// 6": "=== 怎么说话（拟人化）===",
  "humanize": {
    "enabled": true,
    "msPerChar": 85,
    "minMs": 1200,
    "maxMs": 6000,
    "jitter": 0.2,
    "burstMax": 4,
    "gapRange": [
      700,
      2600
    ],
    "longGapChance": 0.25,
    "longGapRange": [
      3000,
      9000
    ]
  },
  "// 7": "=== 数据存哪（账本 + 对话流）===",
  "dataDir": "data",
  "// 8": "=== 日记（她自己写）===",
  "diaryDir": "data/diary",
  "diaryMaxChars": 2000,
  "proactive": {
    "enabled": false
  },
  "ownerNames": {
    "YOUR_QQ_ID": "你的昵称"
  },
  "globalRelationships": true
}
